---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { imageDisplayUrl } from '@/lib/image-url';
import Alert from '@/components/ui/Alert.astro';
import Badge from '@/components/ui/Badge.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { formatPrice } from '@/lib/format';
import { listProducts } from '@/services/products.service';
import { logError } from '@/lib/errors';
import type { Product } from '@/types/catalog';

export const prerender = false;

let products: Product[] = [];
let loadFailed = false;

try {
  products = await listProducts();
} catch (error) {
  logError('admin.products.list', error);
  loadFailed = true;
}
---

<AdminLayout title="Productos">
  <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
    <p class="text-sm text-muted">
      {products.length === 1 ? '1 producto' : `${products.length} productos`} en el catálogo.
    </p>
    <a class="btn btn-primary btn-sm" href="/admin/productos/nuevo">Crear producto</a>
  </div>

  {
    loadFailed ? (
      <Alert tone="error" message="No pudimos cargar los productos. Recarga la página en unos segundos." />
    ) : products.length === 0 ? (
      <EmptyState
        title="Aún no hay productos"
        description="Crea el primero para que aparezca en la tienda."
        actionLabel="Crear producto"
        actionHref="/admin/productos/nuevo"
      />
    ) : (
      <ul class="grid gap-3">
        {products.map((product) => (
          <li class="surface p-4 flex flex-wrap items-center gap-4">
            <img
                src={imageDisplayUrl(product.images[0]?.imageUrl ?? '/imagen-no-disponible.svg')}
              data-fallback="/imagen-no-disponible.svg"
              alt=""
              width="64"
              height="64"
              class="h-16 w-16 rounded-xl object-cover bg-blush/40"
            />

            <div class="min-w-48 grow">
              <p class="font-medium">{product.name}</p>
              <p class="text-sm text-muted">
                {product.categoryName ?? 'Sin categoría'} · {formatPrice(product.priceCents)}
                {product.images.length > 1 && ` · ${product.images.length} imágenes`}
              </p>
            </div>

            <div class="flex items-center gap-2">
              <Badge tone={product.isActive ? 'positive' : 'neutral'} label={product.isActive ? 'Visible' : 'Oculto'} />
              {!product.inStock && <Badge tone="warning" label="Agotado" />}
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <a class="btn btn-secondary btn-sm" href={`/admin/productos/${product.id}/editar`}>
                Editar
              </a>

              <form method="post" action="/api/admin/products">
                <input type="hidden" name="intent" value="toggle" />
                <input type="hidden" name="id" value={product.id} />
                <input type="hidden" name="isActive" value={String(!product.isActive)} />
                <button class="btn btn-ghost btn-sm" type="submit">
                  {product.isActive ? 'Ocultar' : 'Mostrar'}
                </button>
              </form>

              <form
                method="post"
                action="/api/admin/products"
                data-confirm={`¿Eliminar "${product.name}"? Esta acción no se puede deshacer.`}
              >
                <input type="hidden" name="intent" value="delete" />
                <input type="hidden" name="id" value={product.id} />
                <button class="btn btn-danger btn-sm" type="submit">Eliminar</button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</AdminLayout>
