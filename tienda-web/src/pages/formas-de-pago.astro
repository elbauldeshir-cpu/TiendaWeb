---
import StorefrontLayout from '@/layouts/StorefrontLayout.astro';
import { brand, contact, paymentMethods } from '@/config/site';

export const prerender = false;

const methods = paymentMethods.filter((method) => method.enabled);
const whatsappLink = contact.whatsapp ? `https://wa.me/${contact.whatsapp.replace(/\D/g, '')}` : '/contacto';
---

<StorefrontLayout title="Formas de pago" description={`Medios de pago aceptados en ${brand.name}.`}>
  <section class="container-page py-10 md:py-14">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-bubblegum">Compra con calma</p>
      <h1 class="mt-2 text-4xl">Cómo pagar tu pedido</h1>
      <p class="mt-3 text-muted">
      Confirmamos tu compra por WhatsApp y te compartimos los datos del medio de pago que elijas.
      </p>
    </div>

    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        methods.map((method) => (
          <li class="surface p-5 flex flex-col gap-4">
            <div class="flex items-start justify-between gap-3">
              <span class="payment-icon" aria-hidden="true">
                {method.icon === 'bank' && <svg viewBox="0 0 24 24"><path d="M3 10h18M5 10v8m4-8v8m6-8v8m4-8v8M3 20h18M12 3l9 5H3l9-5Z" /></svg>}
                {method.icon === 'wallet' && <svg viewBox="0 0 24 24"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H19a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H6.5A2.5 2.5 0 0 1 4 17.5v-11Z" /><path d="M4 7h14a2 2 0 0 1 2 2v2h-5a2 2 0 0 0 0 4h5v2" /></svg>}
                {method.icon === 'building' && <svg viewBox="0 0 24 24"><path d="M4 20V5l8-2 8 2v15M4 20h16M8 8h1m6 0h1M8 12h1m6 0h1M8 16h1m6 0h1" /></svg>}
                {method.icon === 'smartphone' && <svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2" /><path d="M10 6h4m-2 11h.01" /></svg>}
                {method.icon === 'cash' && <svg viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2" /><circle cx="12" cy="12" r="3" /><path d="M6 9h.01M18 15h.01" /></svg>}
              </span>
              <span class="rounded-full bg-cream px-2 py-1 text-[0.68rem] font-semibold uppercase tracking-wide text-muted">Seguro y fácil</span>
            </div>
            <h2 class="text-lg">{method.name}</h2>
            <p class="mt-2 text-sm text-muted">{method.summary}</p>
            {method.details ? (
              <p class="mt-3 text-sm">{method.details}</p>
            ) : (
              <p class="mt-3 text-sm text-muted">
                Te enviamos los datos al confirmar el pedido.
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl bg-wine p-5 text-white">
      <p class="text-sm">Envíanos el comprobante para despachar tu pedido.</p>
      <a class="btn bg-white text-wine hover:bg-blush" href={whatsappLink}>Escríbenos por WhatsApp</a>
    </div>
  </section>
</StorefrontLayout>
