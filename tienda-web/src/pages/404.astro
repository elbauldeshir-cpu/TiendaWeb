---
import StorefrontLayout from '@/layouts/StorefrontLayout.astro';

export const prerender = false;
---

<StorefrontLayout title="Página no encontrada">
  <section class="container-page py-20 text-center">
    <h1 class="text-3xl">Esta página no existe</h1>
    <p class="mt-3 text-muted">
      Puede que el enlace haya cambiado. Vuelve al catálogo para seguir mirando.
    </p>
    <a class="btn btn-primary mt-6" href="/">Ir al catálogo</a>
  </section>
</StorefrontLayout>
