---
interface Props {
  tone: 'success' | 'error' | 'info';
  message: string;
  class?: string;
}

const { tone, message, class: className = '' } = Astro.props;

const tones = {
  success: 'bg-white border-rose text-wine',
  error: 'bg-white border-wine text-wine',
  info: 'bg-blush border-line text-ink',
} as const;
---

<p
  class={`surface border ${tones[tone]} px-4 py-3 text-sm ${className}`}
  role={tone === 'error' ? 'alert' : 'status'}
>
  {message}
</p>
