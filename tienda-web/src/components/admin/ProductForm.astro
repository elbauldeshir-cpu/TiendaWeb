---
import Field from '@/components/ui/Field.astro';
import { centsToInputValue } from '@/lib/format';
import { imageDisplayUrl } from '@/lib/image-url';
import type { Category, Product, ProductDraft } from '@/types/catalog';

interface Props {
  categories: Category[];
  product?: Product;
  draft?: ProductDraft;
}

const { categories, product, draft } = Astro.props;
const isEdit = Boolean(product);
const name = draft?.name ?? product?.name ?? '';
const price = draft?.price ?? (product ? centsToInputValue(product.priceCents) : '');
const categoryId = draft?.categoryId ?? (product?.categoryId == null ? '' : String(product.categoryId));
const description = draft?.description ?? product?.description ?? '';
const imageUrl = draft?.imageUrl ?? product?.imageUrl ?? '';
const imageAlt = draft?.imageAlt ?? product?.imageAlt ?? '';
const existingImages = product?.images ?? [];
const relatedImages = product?.images.filter((image) => image.imageUrl !== imageUrl) ?? [];
const imageUrls = draft?.imageUrls ?? relatedImages.map((image) => image.imageUrl).join('\n');
const isActive = draft?.isActive ?? product?.isActive ?? true;
const inStock = draft?.inStock ?? product?.inStock ?? true;
---

<form method="post" action="/api/admin/products" enctype="multipart/form-data" class="surface p-6 space-y-5 max-w-2xl" novalidate>
  <input type="hidden" name="intent" value={isEdit ? 'update' : 'create'} />
  {isEdit && <input type="hidden" name="id" value={product?.id} />}

  <Field id="name" label="Nombre del producto" required>
    <input
      class="field-control"
      id="name"
      name="name"
      type="text"
      minlength="2"
      maxlength="120"
      required
      value={name}
    />
  </Field>

  <Field id="price" label="Precio (COP)" hint="Solo números. Ejemplo: 18000" required>
    <input
      class="field-control"
      id="price"
      name="price"
      type="number"
      min="1"
      step="1"
      inputmode="numeric"
      aria-describedby="price-hint"
      required
      value={price}
    />
  </Field>

  <Field id="categoryId" label="Categoría">
    <select class="field-control" id="categoryId" name="categoryId" value={categoryId}>
      <option value="">Sin categoría</option>
      {
        categories.map((category) => (
          <option value={category.id} selected={categoryId === String(category.id)}>
            {category.name}
            {!category.isActive ? ' (oculta)' : ''}
          </option>
        ))
      }
    </select>
  </Field>

  <Field id="description" label="Descripción corta" hint="Máximo 600 caracteres.">
    <textarea
      class="field-control"
      id="description"
      name="description"
      rows="3"
      maxlength="600"
      aria-describedby="description-hint">{description}</textarea>
  </Field>

  <Field id="imageAlt" label="Texto alternativo de la imagen" hint="Describe la foto para lectores de pantalla.">
    <input
      class="field-control"
      id="imageAlt"
      name="imageAlt"
      type="text"
      maxlength="160"
      aria-describedby="imageAlt-hint"
      value={imageAlt}
    />
  </Field>

  <Field
    id="images"
    label="Cargar imágenes"
    hint="Puedes seleccionar varias. Se asociarán a este producto. Máximo 8 imágenes de 8 MB."
  >
    <input
      class="field-control"
      id="images"
      name="images"
      type="file"
      accept="image/jpeg,image/png,image/webp,image/gif,image/avif"
      multiple
      aria-describedby="images-hint"
    />
  </Field>

  {isEdit && existingImages.length > 0 && (
    <fieldset class="space-y-3 rounded-2xl border border-line bg-cream/70 p-4">
      <legend class="field-label px-1">Imágenes asociadas</legend>
      <div class="grid grid-cols-3 gap-3 sm:grid-cols-5">
        {existingImages.map((image, index) => (
          <figure class="overflow-hidden rounded-xl border border-line bg-white">
            <img
              src={imageDisplayUrl(image.imageUrl)}
              alt={image.imageAlt ?? `${name}, imagen ${index + 1}`}
              width="160"
              height="120"
              class="aspect-[4/3] w-full object-cover"
              loading="lazy"
            />
            <figcaption class="truncate px-2 py-1 text-[0.68rem] text-muted">{index === 0 ? 'Principal' : `Imagen ${index + 1}`}</figcaption>
          </figure>
        ))}
      </div>
    </fieldset>
  )}

  <Field
    id="imageUrl"
    label="Imagen principal por URL"
    hint="Opcional. Pega el enlace de Drive obtenido con Compartir > Cualquier persona con el enlace."
  >
    <input
      class="field-control"
      id="imageUrl"
      name="imageUrl"
      type="text"
      aria-describedby="imageUrl-hint"
      value={imageUrl}
    />
  </Field>

  <Field
    id="imageUrls"
    label="Más imágenes por URL"
    hint="Una URL por línea. Las imágenes actuales ya aparecen aquí para que puedas conservarlas."
  >
    <textarea
      class="field-control"
      id="imageUrls"
      name="imageUrls"
      rows="4"
      maxlength="2000"
      placeholder="https://drive.google.com/file/d/.../view"
      aria-describedby="imageUrls-hint">{imageUrls}</textarea>
  </Field>

  <fieldset class="space-y-3">
    <legend class="field-label">Disponibilidad</legend>
    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="isActive" checked={isActive} />
      Visible en la tienda
    </label>
    <label class="flex items-center gap-2 text-sm">
      <input type="checkbox" name="inStock" checked={inStock} />
      Con existencias
    </label>
  </fieldset>

  <div class="flex flex-wrap gap-3 pt-2">
    <button class="btn btn-primary" type="submit">
      {isEdit ? 'Guardar cambios' : 'Crear producto'}
    </button>
    <a class="btn btn-ghost" href="/admin/productos">Cancelar</a>
  </div>
</form>
