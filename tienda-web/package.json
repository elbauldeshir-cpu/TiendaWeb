{
  "name": "el-baul-de-shir",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tienda web y panel administrativo de El Baúl de Shir (Astro + Astro DB + Netlify)",
  "scripts": {
    "dev": "astro dev",
    "dev:remote": "astro dev --remote",
    "build": "astro check && astro build",
    "build:remote": "astro check && astro build --remote",
    "preview": "astro preview",
    "check": "astro check",
    "db:push": "astro db push --remote",
    "db:seed": "astro db execute db/seed.ts --remote",
    "auth:hash": "node scripts/hash-password.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/db": "^0.14.0",
    "@astrojs/netlify": "^6.2.0",
    "@tailwindcss/vite": "4.1.0",
    "astro": "^5.6.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
